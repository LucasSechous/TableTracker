# Fuente de video: índice de webcam (0), ruta a un archivo o URL RTSP de la cámara
VIDEO_SOURCE=0

# Modelo YOLO y umbrales de detección
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE=0.5
# Clases COCO a detectar, separadas por coma (0 = person)
YOLO_CLASSES=0

# Segundos entre frames analizados
FRAME_INTERVAL_SECONDS=2

# Archivo con el mapa de zonas (ROI) por mesa
ZONES_FILE=config/zonas.json

# API de TableTracker
BACKEND_URL=http://localhost:8000
BACKEND_TOKEN=token-jwt-del-usuario-de-servicio

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
