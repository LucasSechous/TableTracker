# --- API de TableTracker ---------------------------------------------------
BACKEND_URL=http://localhost:8000

# Usuario técnico del módulo (T26-129). El módulo se loguea solo y renueva el
# token cuando vence, así que acá van credenciales, no un token.
# Ojo: /camaras y /roi-mesa son solo admin, así que el rol de este usuario tiene
# que poder leerlos además de cambiar el estado de las mesas.
BACKEND_EMAIL=vision-module@tabletracker.com
BACKEND_PASSWORD=

# Segundos de espera de cada pedido a la API
BACKEND_TIMEOUT=10

# --- Sector piloto ---------------------------------------------------------
# Sector cuyo salón mira esta instancia. La cámara y los ROI se leen del backend.
SECTOR_ID=

# Solo si el sector tiene más de una cámara activa: cuál de ellas procesar.
CAMARA_ID=

# Contraseña del stream RTSP. La API devuelve la URL con la contraseña tapada
# («***») a propósito, así que el secreto se carga acá y no viaja por HTTP.
CAMARA_PASSWORD=

# --- Detección -------------------------------------------------------------
# Los pesos se descargan solos la primera vez y quedan en models/ (no se versionan).
# Medido sobre frames reales de 1920x1080, p90 contra el presupuesto de 2s por ciclo:
#   yolov8n -> 640: 12%  | 960: 14%  | 1280: 23%
#   yolov8s -> 640: 18%  | 960: 33%  | 1280: 65%
#   yolov8m -> 640: 39%  | 960: 64%  | 1280: no entra
# yolov8s + imgsz 960 sube modelo y resolución a la vez usando un tercio del ciclo.
YOLO_MODEL_PATH=models/yolov8s.pt

# Resolución de inferencia. El default de ultralytics (640) reescala un frame de 1080p
# a un tercio y pierde a las personas lejanas; subirlo es la palanca que más ayuda con
# gente chica o parcialmente tapada.
YOLO_IMGSZ=960

# Umbral de confianza. Puede ser bajo: aguas abajo filtran el ROI (OVERLAP_MINIMO) y la
# confirmación sostenida (CONFIRMACION_SEGUNDOS).
YOLO_CONFIDENCE=0.35
# Clases COCO a detectar, separadas por coma (0 = person)
YOLO_CLASSES=0

# Segundos entre frames analizados
FRAME_INTERVAL_SECONDS=2

# Cuántos intervalos sin imagen nueva se toleran antes de dar el stream por caído.
INTERVALOS_TOLERADOS_SIN_FRAME=3

# --- Decisión de estado ----------------------------------------------------
# Qué fracción del bounding box de una persona tiene que caer dentro del ROI
# para contarla en esa mesa (0 a 1).
OVERLAP_MINIMO=0.30

# Qué parte del bounding box se compara contra el ROI:
#   bbox_completo    - la persona entera (criterio histórico)
#   tercio_inferior  - solo el tercio de abajo, o sea dónde está apoyada
# El tercio inferior debería andar mejor con gente SENTADA (el bbox es alto y con
# una cámara baja buena parte queda por encima de la mesa en la imagen), pero
# cambia la semántica de OVERLAP_MINIMO. Comparar los dos en las pruebas físicas
# antes de mover el default.
ANCLAJE_OVERLAP=bbox_completo

# Cuánto tiene que sostenerse la observación antes de confirmar el cambio, en
# segundos. Evita que alguien que pasa caminando marque la mesa como ocupada.
CONFIRMACION_SEGUNDOS=6

# --- Robustez de la captura ------------------------------------------------
# Frames vacíos seguidos que se toleran antes de reabrir el stream, y espera
# entre intentos de reapertura.
FRAMES_FALLIDOS_MAXIMOS=5
RECONEXION_SEGUNDOS=5

# --- Desarrollo ------------------------------------------------------------
# Override de la fuente de video: índice de webcam (0), ruta a un archivo de
# imagen o video, o URL RTSP completa. Si está definido se usa esto y NO el
# stream de la cámara registrada en el backend, así que en producción va vacío.
# scripts/test_condiciones.py sí lo exige.
VIDEO_SOURCE=

# Nivel de log: DEBUG, INFO, WARNING, ERROR
# En DEBUG se loguea el overlap de cada mesa en cada frame, útil para calibrar
# OVERLAP_MINIMO contra la cámara real.
LOG_LEVEL=INFO
