DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Clave con la que se cifran las contraseñas RTSP de las cámaras (T26-136).
# Distinta de SECRET_KEY, que es la del JWT: si se filtra una, la otra sigue
# sirviendo. Generala con:
#   python scripts/rotar_clave_camaras.py --generar-clave
# Sin esta variable el backend no puede leer ni guardar contraseñas de cámaras.
# Admite varias separadas por coma para rotar sin cortar el servicio: la primera
# cifra, las demás solo descifran (ver database/README.md).
CAMARA_ENCRYPTION_KEYS=cambiar-por-una-clave-fernet-generada
# Orígenes permitidos por CORS, separados por coma (sin espacios extra ni barra final).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Solo para scripts/probar_snapshot.py (verificación manual de T26-134). Los
# valores de acá son de ejemplo, obviamente falsos: completá los reales en tu
# .env local, nunca en este archivo.
TEST_ADMIN_EMAIL=admin@tu-dominio-de-ejemplo.com
TEST_ADMIN_PASSWORD=tu_password_admin_aqui
CAMARA_TEST_USER=tu_usuario_camara_aqui
CAMARA_TEST_PASSWORD=tu_password_camara_aqui
CAMARA_TEST_IP=192.168.1.100
CAMARA_TEST_SECTOR_ID=1
